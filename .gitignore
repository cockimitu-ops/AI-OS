# Secrets
.env
*.env
!.env.example

# Docker runtime data (server-stack)
server-stack/jellyfin/
server-stack/nextcloud/
server-stack/portainer/

# Node
node_modules/
build/
dist/

# Python
__pycache__/
*.pyc

# TaskRunner runtime data (queue, logs, backup archives - not source)
AI-OS/02_Systems/Automation/TaskRunner/tasks/inbox/*
AI-OS/02_Systems/Automation/TaskRunner/tasks/completed/*
AI-OS/02_Systems/Automation/TaskRunner/tasks/logs/*
AI-OS/02_Systems/Automation/TaskRunner/tasks/threads/*
!AI-OS/02_Systems/Automation/TaskRunner/tasks/**/.gitkeep
AI-OS/02_Systems/Automation/TaskRunner/backups/*.tar.gz
AI-OS/02_Systems/Automation/TaskRunner/health/state.json
AI-OS/02_Systems/Automation/TaskRunner/schedules/state.json
AI-OS/02_Systems/Automation/TaskRunner/watches/state.json
# Per-search health record: runtime data, rebuilt by the next sniper run.
AI-OS/02_Systems/Automation/TaskRunner/watches/health.json
AI-OS/02_Systems/Automation/TaskRunner/prospects/domains.json
AI-OS/02_Systems/Automation/TaskRunner/prospects/results.json
AI-OS/02_Systems/Automation/TaskRunner/prospects/reported.json
AI-OS/02_Systems/Automation/TaskRunner/spend/openrouter_ledger.json
# Per-call spend log and the Claude transcript cost cache: runtime data, and
# the log names the tasks the money went on.
AI-OS/02_Systems/Automation/TaskRunner/spend/openrouter_calls.jsonl
AI-OS/02_Systems/Automation/TaskRunner/spend/claude_cost_cache.json
# One directory per phone-sent Claude turn: the prompt Felix typed, the reply,
# and its cost. His conversations, not source.
AI-OS/02_Systems/Automation/TaskRunner/claude_jobs/*
!AI-OS/02_Systems/Automation/TaskRunner/claude_jobs/.gitkeep
# Live screen frames pulled off a phone.
AI-OS/02_Systems/Automation/TaskRunner/phone/screenshots/*
!AI-OS/02_Systems/Automation/TaskRunner/phone/screenshots/.gitkeep
AI-OS/02_Systems/Automation/TaskRunner/phone/pulled/*
!AI-OS/02_Systems/Automation/TaskRunner/phone/pulled/.gitkeep
# Proposals are runtime state: what agents suggested and what Felix decided.
AI-OS/02_Systems/Automation/TaskRunner/proposals/*.json
AI-OS/02_Systems/Automation/TaskRunner/proposals/*.jsonl
AI-OS/02_Systems/Automation/TaskRunner/outreach/contacted.json
AI-OS/02_Systems/Automation/TaskRunner/outreach/letters.html
AI-OS/02_Systems/Automation/TaskRunner/webapp/static/downloads/*
!AI-OS/02_Systems/Automation/TaskRunner/webapp/static/downloads/.gitkeep
AI-OS/02_Systems/Automation/TaskRunner/techscout/seen.json
AI-OS/02_Systems/Automation/TaskRunner/techscout/digest.md

# Private WhatsApp import: Felix's own messages, the derived stats, and the
# generated voice profile. None of this belongs in a repo that syncs to
# Notion - it is personal chat content, and the profile embeds real messages.
AI-OS/02_Systems/Automation/TaskRunner/voice/*
!AI-OS/02_Systems/Automation/TaskRunner/voice/.gitkeep

# Whatever Felix uploads through the web client - chat exports and similar
# private data. Same reasoning as voice/.
AI-OS/02_Systems/Automation/TaskRunner/uploads/*
!AI-OS/02_Systems/Automation/TaskRunner/uploads/.gitkeep

# Study ingestion runtime state: which notes have been processed already.
AI-OS/02_Systems/Automation/TaskRunner/study/*
!AI-OS/02_Systems/Automation/TaskRunner/study/.gitkeep

# Secure Content Protocol: project docs stay out of the committed, Notion-synced
# vault by default. The threat model in that folder names its own documentation
# as a leak vector - committing it would contradict the project's first
# requirement. Reversible on request; the folder still exists locally and is
# still covered by the vault backup.
AI-OS/10_Projects/SecureContentProtocol/
AI-OS/02_Systems/Automation/TaskRunner/watches/finds.json

# Phone screenshots: whatever is on Felix's screen at the time.
AI-OS/02_Systems/Automation/TaskRunner/phone/screenshots/

# Compute node registry and job queue: runtime state.
AI-OS/02_Systems/Automation/TaskRunner/nodes/
AI-OS/02_Systems/Automation/TaskRunner/jobs/
AI-OS/02_Systems/Automation/TaskRunner/phone/nothing_port.json
