// Die Malschicht für AI-OS.
//
// WAS SICH GEGENÜBER DER VORIGEN FASSUNG GEÄNDERT HAT
//
// Vorher malte diese Datei 42 weiche Farbkreise auf ein Achtel der Auflösung
// und skalierte das hoch. Das Hochskalieren WAR die Technik - es löscht jede
// Kante, und genau deshalb kam ein Farbfeld heraus und keine Malerei. Felix
// hat das zu Recht als "nur grobe Farbpaletten" beanstandet.
//
// Jetzt wird wirklich gestrichen. Fünf Dinge tragen das:
//
// 1. BORSTEN. Ein Strich ist kein Fleck, sondern 4-7 parallele Linien mit
//    Lücken. Diese Striemen sind das, woran das Auge einen Borstenpinsel
//    erkennt. Jede Borste bekommt einen eigenen Ton - Monets "couleur
//    rompue": ungemischte Farben nebeneinander, die sich erst im Auge
//    mischen. Er hat Grau nie angerührt, sondern Blau neben Orange gelegt.
//
// 2. IMPASTO. Die Farbe steht auf der Leinwand. Jeder Strich wird dreimal
//    gemalt: abgedunkelter Schatten nach unten-rechts, Körper, aufgehellter
//    Grat nach oben-links. Relief ohne 3D und ohne WebGL. Dafür liegen drei
//    Leinwände übereinander statt einer.
//
// 3. KOMPOSITION. Jedes Licht hat einen Horizont, eigene Farben für Himmel
//    und Wasser, Luftperspektive und benannte Motive aus konkreten Bildern.
//    Ohne Horizont gibt es kein Vorn und Hinten, und ohne das bleibt jede
//    Fläche gleich weit weg - das ist der Unterschied zwischen Textur und
//    Bild.
//
// 4. STILLSTAND. Ein Gemälde bewegt sich nicht. Was sich bewegt, ist das
//    Licht darauf: beim Kippen des Telefons verschieben sich Grat und
//    Schatten gegeneinander, und die Farbe fängt es. Das Bild selbst wird
//    EINMAL gemalt. Pro Frame kostet es damit zwei CSS-Transforms statt
//    tausend Striche - deutlich billiger als das Driften vorher.
//
// 5. SCHRITTWEISE. Ein ganzes Bild am Stück zu malen blockiert auf dem
//    Telefon mehrere Sekunden. stroke() zeichnet deshalb nicht selbst,
//    sondern reiht ein; drain() arbeitet die Schlange mit höchstens 10 ms
//    pro Frame ab. Der Eingriff sitzt bewusst in stroke() und nicht in den
//    Motiven: so wird auch alles aus paint-motifs.js automatisch verteilt
//    gemalt, ohne dass eine Zeile darin davon wissen muss.
//
// DIE SCHNITTSTELLE IST UNVERÄNDERT. app.js ruft fxSetLight, fxLight,
// fxReveal, fxCountUp und fxTap - alle fünf gibt es unten weiter, mit
// derselben Bedeutung, und body[data-light] wird weiter gestempelt, weil
// style.css jede Farbe daran hängt.
//
// Keine Abhängigkeiten, kein Build-Schritt.

(() => {
  "use strict";

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const bodyCanvas = document.getElementById("fx-canvas");
  if (!bodyCanvas) return;

  // --- die Lichter ---------------------------------------------------------
  //
  // Jedes ist ein konkretes Bild, keine Stimmung, und jedes ist eine
  // Komposition:
  //
  //   horizon  wo die Trennlinie liegt (0 oben, 1 unten)
  //   sky      Pigmente oberhalb, water die unterhalb - Himmel und Wasser
  //            sind nie dieselben Farben, auch wenn eines das andere spiegelt
  //   haze     wohin beide Zonen zum Horizont hin verblassen
  //   hazeAmt  wie stark. Am Hafen viel, am Teich fast nichts: Luftperspektive
  //            ist eine Funktion der Entfernung, und drei Meter vor dem Ufer
  //            liegt keine Luft, die etwas ausbleicht
  //   scene    welche Motive daraufkommen, in Malreihenfolge
  //
  // Die Horizonte liegen bewusst tief: darüber steht im Client die
  // Oberfläche, und ein Ufer hinter einem Panel ist ein Ufer, das niemand
  // sieht.

  const LIGHTS = {
    dawn: {
      ref: "Impression, soleil levant (1872)",
      ground: [188, 192, 196],
      horizon: 0.46,
      sky:   [[198,202,208],[182,188,200],[206,202,196],[190,194,204],[172,180,196]],
      water: [[132,150,166],[150,166,180],[120,138,152],[164,158,176],[142,154,170]],
      haze:  [202,206,210], hazeAmt: 0.65,
      pigments: [[150,166,180],[178,180,192],[196,190,188],[132,150,166],
                 [206,202,196],[164,158,176],[120,138,152]],
      accent: [[214,108,52],[226,140,72]],
      // Niedrig: die Sonnenscheibe ist die einzige konzentrierte Akzentfläche.
      // Streute die freie Textur genauso viel Orange, gäbe es ein Dutzend
      // kleiner Sonnen statt einer.
      accentRate: 0.015,
      scene: ["cliff", "sun", "sailboats"],
    },
    day: {
      ref: "Le Bassin aux nymphéas (1899)",
      ground: [226, 220, 200],
      horizon: 0.50,
      sky:   [[92,132,112],[104,140,96],[168,186,132],[128,158,104],[86,116,92]],
      water: [[74,116,140],[126,150,178],[104,140,96],[142,124,160],[96,134,150]],
      haze:  [206,210,186], hazeAmt: 0.16,
      pigments: [[104,140,96],[74,116,140],[168,186,132],[126,150,178],
                 [214,206,172],[142,124,160],[92,132,112]],
      accent: [[226,138,150],[240,214,96]],
      accentRate: 0.05,
      scene: ["poplars", "bridge", "willow", "pond"],
    },
    dusk: {
      ref: "Le Parlement, coucher de soleil",
      ground: [196, 158, 148],
      horizon: 0.56,
      sky:   [[232,190,150],[226,170,96],[212,132,120],[236,200,170],[204,146,132]],
      water: [[150,110,146],[120,104,150],[96,88,130],[168,126,132],[132,102,140]],
      haze:  [236,196,168], hazeAmt: 0.55,
      pigments: [[212,132,120],[150,110,146],[226,170,96],[120,104,150],
                 [232,190,150],[168,126,132],[96,88,130]],
      accent: [[240,88,64],[252,206,110]],
      accentRate: 0.05,
      scene: ["cathedral", "spires", "sun", "sailboats"],
    },
    night: {
      ref: "Nymphéas, effet du soir",
      ground: [20, 26, 40],
      horizon: 0.40,
      sky:   [[26,58,78],[22,52,66],[38,30,58],[30,48,70]],
      water: [[28,42,72],[46,36,74],[16,22,38],[58,48,88],[24,50,68]],
      haze:  [46,58,86], hazeAmt: 0.20,
      pigments: [[28,42,72],[46,36,74],[22,52,66],[16,22,38],
                 [58,48,88],[26,58,78],[38,30,58]],
      accent: [[92,150,150],[150,130,90]],
      accentRate: 0.05,
      scene: ["poplars", "willow", "pond-dim"],
    },
  };

  // Grenzen für jemanden, der regelmäßig um zwei Uhr nachts wach ist: die
  // Nacht läuft lang, der Morgen ist kurz, und der Abend fängt früh genug an,
  // dass ein deutscher Winterabend nicht noch Mittag malt.
  function lightForHour(h) {
    if (h >= 22 || h < 6) return "night";
    if (h < 9) return "dawn";
    if (h < 17) return "day";
    return "dusk";
  }

  // --- die drei Leinwände --------------------------------------------------
  //
  // index.html bringt nur #fx-canvas mit. Grat und Schatten kommen hier dazu,
  // damit die Seite dafür nicht angefasst werden muss. Reihenfolge im DOM ist
  // die Stapelreihenfolge: Schatten, Körper, Grat - und darüber der Schleier,
  // der schon dort steht.

  const LAYER_CSS = "position:fixed;inset:0;z-index:0;pointer-events:none";

  function addLayer(id, before) {
    let el = document.getElementById(id);
    if (!el) {
      el = document.createElement("canvas");
      el.id = id;
      el.setAttribute("aria-hidden", "true");
      el.style.cssText = LAYER_CSS;
      before.parentNode.insertBefore(el, before);
    }
    return el;
  }

  // Auch die mitgelieferte Leinwand bekommt die Lage inline. style.css sagt
  // für #fx-canvas dasselbe, aber sich darauf zu verlassen hiess: in jeder
  // anderen Seite, die fx.js einbindet, steht die Leinwand im Textfluss und
  // schiebt den ganzen Inhalt vor sich her. Genau das ist beim ersten
  // Layout-Prototyp passiert.
  bodyCanvas.style.cssText = LAYER_CSS;

  const shadowCanvas = addLayer("fx-shadow", bodyCanvas);
  const ridgeCanvas = addLayer("fx-ridge", bodyCanvas.nextSibling || null);
  if (!ridgeCanvas.parentNode) bodyCanvas.parentNode.appendChild(ridgeCanvas);
  const layers = [shadowCanvas, bodyCanvas, ridgeCanvas];

  let W = 0, H = 0, dpr = 1;
  let lightName = lightForHour(new Date().getHours());
  let L = LIGHTS[lightName];
  let manual = null;

  const rand = (a, b) => a + Math.random() * (b - a);
  const clamp255 = (v) => (v < 0 ? 0 : v > 255 ? 255 : v);
  const shade = (c, k) => [clamp255(c[0] * k), clamp255(c[1] * k), clamp255(c[2] * k)];
  const mix = (a, b, t) =>
    [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t];
  const one = (arr) => arr[(Math.random() * arr.length) | 0];
  const rgba = (c, a) => `rgba(${c[0] | 0},${c[1] | 0},${c[2] | 0},${a})`;

  // --- einreihen statt sofort zeichnen -------------------------------------

  let queue = null;

  function stroke(ctxs, x, y, len, wide, ang, col, alpha) {
    if (queue) {
      queue.push(() => drawStroke(ctxs, x, y, len, wide, ang, col, alpha));
      return;
    }
    drawStroke(ctxs, x, y, len, wide, ang, col, alpha);
  }

  // Ein Strich: mehrere Borsten mit Lücken, jede in eigenem Ton, und alle drei
  // Ebenen zugleich bedient.
  function drawStroke(ctxs, x, y, len, wide, ang, col, alpha) {
    const [sctx, bctx, rctx] = ctxs;
    const n = 4 + ((Math.random() * 4) | 0);
    const step = wide / n;
    const cos = Math.cos(ang), sin = Math.sin(ang);
    const bow = rand(-0.22, 0.22) * len;   // ein Handgelenk zieht keine Geraden

    for (let i = 0; i < n; i++) {
      const off = (i - (n - 1) / 2) * step;
      const ox = -sin * off, oy = cos * off;
      const l = len * rand(0.72, 1.0);     // Borsten fransen ungleich aus
      const x0 = x - cos * l / 2 + ox, y0 = y - sin * l / 2 + oy;
      const x1 = x + cos * l / 2 + ox, y1 = y + sin * l / 2 + oy;
      const mx = (x0 + x1) / 2 - sin * bow, my = (y0 + y1) / 2 + cos * bow;
      const c = shade(col, rand(0.86, 1.14));
      const bw = step * rand(0.55, 0.95);
      const a = alpha * rand(0.75, 1.0);

      const path = (cx) => {
        cx.beginPath();
        cx.moveTo(x0, y0);
        cx.quadraticCurveTo(mx, my, x1, y1);
        cx.stroke();
      };

      sctx.lineWidth = bw * 1.15; sctx.lineCap = "round";
      sctx.strokeStyle = rgba(shade(c, 0.55), a * 0.55);
      sctx.save(); sctx.translate(1.1, 1.4); path(sctx); sctx.restore();

      bctx.lineWidth = bw; bctx.lineCap = "round";
      bctx.strokeStyle = rgba(c, a);
      path(bctx);

      // Der Grat ist schmaler als der Strich: Licht fängt sich auf der Kante,
      // nicht auf der ganzen Breite.
      rctx.lineWidth = bw * 0.42; rctx.lineCap = "round";
      rctx.strokeStyle = rgba(shade(c, 1.5), a * 0.5);
      rctx.save(); rctx.translate(-1.0, -1.3); path(rctx); rctx.restore();
    }
  }

  // --- Motive --------------------------------------------------------------

  function reflect(ctxs, x, w, col, strength = 1) {
    // Was über dem Wasser steht, steht zerrissen auch darin: eine senkrechte
    // Kette waagerechter Tupfer, die nach unten ausblasst. Daran erkennt man
    // Wasser, ohne eine einzige Welle zu zeichnen.
    const hz = H * L.horizon;
    const depth = (H - hz) * 0.6;
    for (let i = 0; i < 20; i++) {
      const t = i / 20;
      const wob = Math.sin(i * 0.85) * w * 0.18 + rand(-w * 0.06, w * 0.06);
      stroke(ctxs, x + wob, hz + t * depth, w * rand(0.45, 1.05) * (1 + t),
             rand(4, 11), 0, col, rand(0.10, 0.28) * strength * (1 - t));
    }
  }

  function lilyPad(ctxs, cx, cy, r, col) {
    // Die Kerbe zur Mitte hin ist es, woran jeder ein Seerosenblatt erkennt -
    // nicht der Kreis.
    const notch = Math.random() * Math.PI * 2;
    const notchWidth = rand(0.35, 0.55);
    const rim = shade(col, 0.6);
    for (let i = 0; i < 16; i++) {
      const a = (i / 16) * Math.PI * 2;
      let d = a - notch; d = ((d + Math.PI) % (Math.PI * 2)) - Math.PI;
      if (Math.abs(d) < notchWidth / 2) continue;
      const px = cx + Math.cos(a) * r, py = cy + Math.sin(a) * r * 0.55;
      stroke(ctxs, px, py, r * rand(0.5, 0.75), r * rand(0.28, 0.4),
             a + Math.PI / 2, col, rand(0.55, 0.85));
      stroke(ctxs, px * 0.94 + cx * 0.06, py * 0.94 + cy * 0.06,
             r * 0.5, r * 0.14, a, rim, rand(0.4, 0.6));
    }
    if (Math.random() < 0.32) {
      const petal = Math.random() < 0.5 ? [252, 238, 244] : [250, 248, 232];
      for (let i = 0; i < 6; i++) {
        const a = Math.random() * Math.PI * 2;
        stroke(ctxs, cx + Math.cos(a) * r * 0.14, cy + Math.sin(a) * r * 0.10,
               r * 0.22, r * 0.12, a, petal, rand(0.7, 0.95));
      }
    }
  }

  function pond(ctxs, col, density = 1) {
    // Blätter in unregelmäßigen Gruppen, nie im Raster - ein Raster wäre
    // Tapete, kein Teich.
    const clusters = Math.round((4 + Math.random() * 3) * density);
    for (let c = 0; c < clusters; c++) {
      const ccx = rand(0.06, 0.94) * W, ccy = rand(0.5, 0.95) * H;
      const n = Math.round((2 + Math.random() * 4) * density);
      for (let i = 0; i < n; i++) {
        lilyPad(ctxs,
                ccx + rand(-1, 1) * W * 0.09,
                Math.min(ccy + rand(-1, 1) * H * 0.05, H * 0.97),
                Math.min(W, H) * rand(0.032, 0.062),
                shade(col, rand(0.85, 1.15)));
      }
    }
  }

  function sunDisc(ctxs, col) {
    // Muss deutlich größer und dichter sein als jeder Strich ringsum, sonst
    // verschwindet die Sonne im Feld statt es zu tragen.
    const cx = W * rand(0.44, 0.56), cy = H * rand(0.38, 0.44);
    const r = Math.min(W, H) * 0.11;
    for (let i = 0; i < 30; i++) {
      const a = Math.random() * Math.PI * 2, jr = rand(0, r * 0.35);
      stroke(ctxs, cx + Math.cos(a) * jr, cy + Math.sin(a) * jr * 0.6,
             r * rand(0.9, 1.3), r * rand(1.1, 1.5), a, col, rand(0.55, 0.8));
    }
    const core = shade(col, 1.25);
    for (let i = 0; i < 12; i++) {
      stroke(ctxs, cx, cy, r * 0.7, r * 0.9, Math.random() * Math.PI * 2, core, rand(0.65, 0.9));
    }
    for (let i = 0; i < 30; i++) {
      const py = cy + r * 0.9 + (i / 30) * (H * 0.4);
      const wob = Math.sin(i * 0.9) * r * 0.22 + rand(-r * 0.08, r * 0.08);
      stroke(ctxs, cx + wob, py, r * rand(0.9, 1.6), r * rand(0.55, 0.85), 0,
             col, rand(0.35, 0.6) * (1 - i / 34));
    }
  }

  function spires(ctxs, col) {
    const baseY = H * rand(0.56, 0.64);
    const n = 9 + ((Math.random() * 4) | 0);
    for (let i = 0; i < n; i++) {
      const x = (i / n) * W + rand(-10, 10);
      const h = H * rand(0.05, 0.16) * (i % 3 === 0 ? 1.6 : 1);
      for (let s = 0; s < 6; s++) {
        const t = s / 6;
        stroke(ctxs, x, baseY - h * t, h / 6 * 1.6, (1 - t) * rand(10, 22) + 4,
               Math.PI / 2, col, rand(0.55, 0.8));
      }
    }
    for (let i = 0; i < 26; i++) {
      stroke(ctxs, (i / 26) * W, baseY + rand(2, 14), W / 24, rand(4, 10),
             rand(-0.05, 0.05), col, rand(0.2, 0.35));
    }
  }

  function willow(ctxs, col) {
    // Die Krone sitzt am Ufer, nicht an der Bildkante: ein Baum wächst aus dem
    // Horizont. Vom oberen Rand herabhängend wäre er hier ohnehin unsichtbar,
    // dort steht die Oberfläche.
    const hz = H * L.horizon;
    const side = Math.random() < 0.5 ? 0 : 1;
    const rootX = side ? W * rand(0.72, 0.95) : W * rand(0.05, 0.28);
    const spread = W * rand(0.28, 0.44);
    for (let i = 0; i < 26; i++) {
      const x = rootX + (side ? -1 : 1) * Math.pow(Math.random(), 1.5) * spread;
      const top = hz - H * rand(0.06, 0.14);
      const len = H * rand(0.20, 0.48);
      for (let s = 0; s < 9; s++) {
        const t = s / 9;
        stroke(ctxs, x + Math.sin(t * 3 + i) * 10 * t, top + t * len,
               len / 9 * 1.5, rand(4, 11) * (1 - t * 0.5),
               Math.PI / 2 + rand(-0.12, 0.12),
               shade(col, rand(0.75, 1.15)), rand(0.3, 0.62) * (1 - t * 0.35));
      }
    }
  }

  function sailboats(ctxs, col) {
    // Klein und knapp über dem Horizont: sie geben dem Wasser seinen Maßstab.
    const hz = H * L.horizon;
    const n = 2 + ((Math.random() * 3) | 0);
    const dark = shade(col, 0.45);
    for (let i = 0; i < n; i++) {
      const x = W * rand(0.08, 0.92);
      const far = rand(0, 1);
      const y = hz - rand(2, 26) * (1 - far * 0.5);
      const h = H * rand(0.07, 0.15) * (1 - far * 0.4);
      for (let s = 0; s < 7; s++) {
        const t = s / 7;
        stroke(ctxs, x + t * h * 0.12, y - t * h,
               h * 0.10 * (1 - t) + 3, h * 0.16 * (1 - t) + 2,
               Math.PI / 2, shade(dark, rand(0.9, 1.3)), rand(0.45, 0.75));
      }
      stroke(ctxs, x, y + 2, h * 0.34, rand(4, 7), 0, dark, rand(0.5, 0.8));
      reflect(ctxs, x, h * 0.3, dark, 0.75);
    }
  }

  // paint-motifs.js darf weitere Motive beisteuern. Fehlt die Datei oder ein
  // Name darin, passiert nichts - ein fehlendes Motiv darf nie das ganze Bild
  // kosten.
  function runMotif(name, ctxs) {
    const water = L.water || L.pigments;
    if (name === "pond")      return pond(ctxs, water[0]);
    if (name === "pond-dim")  return pond(ctxs, water[0], 0.6);
    if (name === "sun")       return sunDisc(ctxs, L.accent[0]);
    if (name === "spires")    return spires(ctxs, shade(L.pigments[3], 0.55));
    if (name === "willow")    return willow(ctxs, (L.sky || L.pigments)[0]);
    if (name === "sailboats") return sailboats(ctxs, water[0]);
    const ext = window.MOTIFS && window.MOTIFS[name];
    if (typeof ext === "function") {
      try {
        ext({
          stroke: (x, y, len, wide, ang, col, alpha) =>
            stroke(ctxs, x, y, len, wide, ang, col, alpha),
          rand, shade, mix,
          reflect: (x, w, col, s) => reflect(ctxs, x, w, col, s),
        }, W, H, L);
      } catch (e) {
        console.warn("Motiv", name, "ist gescheitert:", e);
      }
    }
  }

  // --- das Bild ------------------------------------------------------------

  let drainId = null;

  // Zehn Millisekunden pro Frame: genug, dass das Bild zügig wächst, wenig
  // genug, dass Wischen und Tippen daneben flüssig bleiben.
  function drain(tasks) {
    let i = 0;
    const step = () => {
      const frameStart = performance.now();
      while (i < tasks.length && performance.now() - frameStart < 10) tasks[i++]();
      drainId = i < tasks.length ? requestAnimationFrame(step) : null;
    };
    drainId = requestAnimationFrame(step);
  }

  function paint() {
    // Einen laufenden Auftrag abbrechen, sonst malen zwei Bilder übereinander,
    // wenn schnell das Licht gewechselt wird.
    if (drainId !== null) { cancelAnimationFrame(drainId); drainId = null; }

    const ctxs = layers.map((c) => {
      const cx = c.getContext("2d");
      cx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cx.clearRect(0, 0, W, H);
      return cx;
    });
    const bctx = ctxs[1];

    // Die Grundierung sofort: es darf nie eine leere Leinwand zu sehen sein,
    // auch nicht für einen Frame.
    bctx.fillStyle = rgba(L.ground, 1);
    bctx.fillRect(0, 0, W, H);

    queue = [];

    const diag = Math.hypot(W, H);
    const hz = H * L.horizon;
    const sky = L.sky || L.pigments;
    const water = L.water || L.pigments;
    const haze = L.haze || shade(L.ground, 1.05);
    const hazeAmt = L.hazeAmt ?? 0.55;

    // Untermalung, zonenweise: die groben Massen, bevor ein Detail da ist.
    for (let i = 0; i < 140; i++) {
      const x = Math.random() * W, y = Math.random() * H;
      const above = y < hz;
      stroke(ctxs, x, y, diag * rand(0.10, 0.26), rand(40, 92),
             above ? rand(-0.10, 0.10) : rand(-0.05, 0.05),
             one(above ? sky : water), rand(0.10, 0.22));
    }

    // Himmel: fast waagerecht, zum Horizont hin kürzer, blasser, dunstiger.
    const skyN = Math.round((W * hz) / 560);
    for (let i = 0; i < skyN; i++) {
      const x = Math.random() * W, y = Math.random() * hz;
      const far = Math.pow(y / Math.max(1, hz), 1.6);
      stroke(ctxs, x, y, rand(34, 104) * (1 - far * 0.45), rand(11, 28) * (1 - far * 0.35),
             rand(-0.12, 0.12), mix(one(sky), haze, far * hazeAmt),
             rand(0.24, 0.55) * (1 - far * 0.25));
    }

    // Wasser: strikt waagerecht - die einzige Regel, die eine Fläche zu Wasser
    // macht. Nach vorn länger und dunkler, nach hinten kürzer und dunstiger.
    const waterN = Math.round((W * (H - hz)) / 460);
    for (let i = 0; i < waterN; i++) {
      const x = Math.random() * W, y = hz + Math.random() * (H - hz);
      const near = (y - hz) / Math.max(1, H - hz);
      const base = one(water);
      stroke(ctxs, x, y, rand(26, 104) * (0.45 + near * 0.85),
             rand(8, 24) * (0.55 + near * 0.7), rand(-0.045, 0.045),
             mix(mix(base, haze, (1 - near) * hazeAmt * 0.8), shade(base, 0.78), near * 0.45),
             rand(0.28, 0.6));
    }

    // Eine helle Kante genau auf dem Horizont. Ohne sie laufen die Zonen
    // ineinander und die Tiefe geht wieder verloren.
    for (let i = 0; i < 26; i++) {
      stroke(ctxs, Math.random() * W, hz + rand(-3, 3), rand(40, 130), rand(3, 7), 0,
             mix(haze, one(sky), 0.4), rand(0.22, 0.5));
    }

    // Die Szene zuletzt, nicht zuerst: sonst wäscht der freie Teppich darüber
    // jede erkennbare Form wieder aus. Monet hat genauso gearbeitet - erst die
    // Fläche, dann das, woran das Auge sich festhält.
    for (const m of (L.scene || [])) runMotif(m, ctxs);

    // Akzente: kurz, dick, satt, wenige. Das Letzte, was auf ein Bild kommt,
    // und das Erste, was man sieht.
    for (let i = 0; i < (skyN + waterN) * 0.05; i++) {
      stroke(ctxs, Math.random() * W, Math.random() * H, rand(8, 22), rand(7, 15),
             rand(-0.5, 0.5), one(L.accent), rand(0.35, 0.7));
    }

    const tasks = queue;
    queue = null;
    drain(tasks);
  }

  // --- die Leinwand --------------------------------------------------------
  //
  // Grobes Leinen mit Bindung und ungleichmäßigem Faden, einmal in eine Kachel
  // gerechnet. Sie ersetzt die Rauschtextur, die #fx-grain vorher trug: Korn
  // sieht aus wie ein fotografiertes Bild, Gewebe wie eine bemalte Leinwand.
  // Deckkraft und Mischmodus kommen weiter aus style.css.

  function weaveInto(el) {
    if (!el) return;
    const S = 64;
    const tile = document.createElement("canvas");
    tile.width = tile.height = S;
    const tx = tile.getContext("2d");
    const img = tx.createImageData(S, S);
    for (let y = 0; y < S; y++) {
      for (let x = 0; x < S; x++) {
        const warp = Math.sin(x * Math.PI / 3.1) * 0.5 + 0.5;
        const weft = Math.sin(y * Math.PI / 3.4) * 0.5 + 0.5;
        // Über/unter - die Bindung, die ein Gewebe von Streifen unterscheidet.
        const over = (((x / 3) | 0) + ((y / 3) | 0)) % 2 ? warp : weft;
        const v = clamp255((0.62 + over * 0.38 + (Math.random() - 0.5) * 0.22) * 255);
        const i = (y * S + x) * 4;
        img.data[i] = img.data[i + 1] = img.data[i + 2] = v;
        img.data[i + 3] = 255;
      }
    }
    tx.putImageData(img, 0, 0);
    el.style.backgroundImage = `url("${tile.toDataURL("image/png")}")`;
    el.style.backgroundRepeat = "repeat";
  }

  // --- Licht, das wandert --------------------------------------------------
  //
  // Das Bild bewegt sich nicht. Grat und Schatten werden gegeneinander
  // verschoben, und genau das liest das Auge als Farbe, die Licht fängt.
  // Der Frame kostet zwei Transforms; steht das Ziel still, hält die Schleife
  // ganz an, damit ein liegendes Telefon nichts verbraucht.

  let lx = 0, ly = 0, tx = 0, ty = 0, tiltId = null;

  function tiltFrame() {
    lx += (tx - lx) * 0.08;
    ly += (ty - ly) * 0.08;
    ridgeCanvas.style.transform = `translate(${(-lx * 3).toFixed(2)}px,${(-ly * 3).toFixed(2)}px)`;
    shadowCanvas.style.transform = `translate(${(lx * 3).toFixed(2)}px,${(ly * 3).toFixed(2)}px)`;
    if (Math.abs(tx - lx) < 0.002 && Math.abs(ty - ly) < 0.002) { tiltId = null; return; }
    tiltId = requestAnimationFrame(tiltFrame);
  }

  function aimLight(nx, ny) {
    if (reduceMotion) return;
    tx = Math.max(-1, Math.min(1, nx));
    ty = Math.max(-1, Math.min(1, ny));
    if (tiltId === null) tiltId = requestAnimationFrame(tiltFrame);
  }

  window.addEventListener("deviceorientation", (e) => {
    if (e.gamma == null) return;
    aimLight(e.gamma / 35, ((e.beta || 0) - 45) / 35);
  }, { passive: true });

  document.addEventListener("pointermove", (e) => {
    aimLight((e.clientX / window.innerWidth) * 2 - 1,
             (e.clientY / window.innerHeight) * 2 - 1);
  }, { passive: true });

  // --- Aufbau --------------------------------------------------------------

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = window.innerWidth;
    H = window.innerHeight;
    for (const c of layers) {
      c.width = Math.round(W * dpr);
      c.height = Math.round(H * dpr);
      c.style.width = W + "px";
      c.style.height = H + "px";
    }
    paint();
  }

  // Geprüft statt geplant: ein Telefon, das von Mitternacht bis acht schlief,
  // führt keinen Timer aus, der für sechs Uhr gestellt war.
  function refreshLight() {
    const name = manual || lightForHour(new Date().getHours());
    document.body.dataset.light = name;
    if (name === lightName) return;
    lightName = name;
    L = LIGHTS[name];
    paint();
  }
  setInterval(refreshLight, 60000);

  let resizeTimer = null;
  window.addEventListener("resize", () => {
    // Entprellt: mobile Browser feuern beim Einklappen der Adressleiste
    // dauernd resize, und jedes Mal neu zu malen wäre ein sichtbarer Ruckler
    // mitten im Scrollen.
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(resize, 180);
  });

  document.addEventListener("visibilitychange", () => {
    if (document.hidden) {
      if (drainId !== null) { cancelAnimationFrame(drainId); drainId = null; }
      if (tiltId !== null) { cancelAnimationFrame(tiltId); tiltId = null; }
    } else {
      refreshLight();
    }
  });

  // --- die Schnittstelle, unverändert ---------------------------------------

  // Ein von Hand gewähltes Licht, oder nichts für "folge der Uhr".
  window.fxSetLight = function (name) {
    if (!name || name === "auto") {
      manual = null;
      refreshLight();
      return true;
    }
    if (!LIGHTS[name]) return false;
    manual = name;
    if (name !== lightName) {
      lightName = name;
      L = LIGHTS[name];
      document.body.dataset.light = name;
      paint();
    } else {
      document.body.dataset.light = name;
    }
    return true;
  };

  window.fxLight = function () {
    return { name: lightName, auto: !manual, names: Object.keys(LIGHTS) };
  };

  // Elemente kommen versetzt statt alle auf einmal. Öffentlich, weil die
  // Screen-Renderer es nach ihrem eigenen innerHTML aufrufen - was die meisten
  // tun, sodass ein MutationObserver hier die App bekämpfen statt ihr helfen
  // würde.
  window.fxReveal = function (root, selector, step = 55) {
    if (reduceMotion || !root) return;
    root.querySelectorAll(selector).forEach((el, i) => {
      el.classList.add("fx-in");
      el.style.animationDelay = `${i * step}ms`;
    });
  };

  // Zahlen zählen hoch statt zu erscheinen. Auf einem Dashboard, dessen ganzer
  // Sinn "0 Briefe raus" ist, zieht eine steigende Zahl den Blick anders als
  // eine stehende Ziffer.
  window.fxCountUp = function (el, target, duration = 900) {
    const end = Number(target) || 0;
    if (reduceMotion || end === 0) { el.textContent = String(end); return; }
    const startedAt = performance.now();
    const tick = (now) => {
      const t = Math.min((now - startedAt) / duration, 1);
      // easeOutExpo: schnell heraus, langer Auslauf - liest sich entschieden
      // statt wie ein Ladebalken.
      const eased = t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
      el.textContent = String(Math.round(end * eased));
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  // Ein kurzer Klopfer auf der Navigation. Android beachtet das, iOS ignoriert
  // es still - das ist das richtige Nichts, nicht etwas zum Abfragen.
  window.fxTap = function (ms = 8) {
    if (navigator.vibrate) { try { navigator.vibrate(ms); } catch (_) {} }
  };

  weaveInto(document.getElementById("fx-grain"));
  refreshLight();
  resize();
})();
