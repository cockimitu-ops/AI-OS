# AI Bridge — Konfiguration
# Kopieren:  cp .env.example .env
#
# Diese Datei deckt beide Startarten ab: `node bridge.mjs ...` direkt und
# `docker compose up`. Docker liest dieselbe .env, braucht aber zusaetzlich
# CLAUDE_CODE_OAUTH_TOKEN und BRIDGE_TOKEN (im Container gibt es keinen Browser-Login).

# --- Gemini (Pflicht) ---
# Key aus Google AI Studio.
GEMINI_API_KEY=
# Gueltige ID abfragen mit: node bridge.mjs models
GEMINI_MODEL=gemini-flash-latest

# --- Claude ---
CLAUDE_MODEL=sonnet
CLAUDE_TIMEOUT_MS=300000
# Nur fuer Docker noetig: auf dem Host `claude setup-token` laufen lassen.
# ACHTUNG: siehe README - der Claude-Pfad ist seit 2026-08-26 geparkt.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Nur fuer docker compose (server.mjs) ---
# Shared Secret fuer die HTTP-Endpunkte. Leer lassen = offen, deshalb setzen.
BRIDGE_TOKEN=
# Parallele Claude-Prozesse. Auf 1 lassen.
MAX_CONCURRENT_CLAUDE=1
# Wohin die Session-Markdowns geschrieben werden.
SPACE_DIR=./space
